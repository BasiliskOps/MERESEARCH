# Copy to .env and fill in. .env is gitignored; never commit real values.

# Anthropic — frontier monitors (arms A, B, C) and reproduction (arm E)
ANTHROPIC_API_KEY=

# Cloudflare Workers AI — Jev state layer (arm D and the ledger feeding B and C)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Override only if the day-one endpoint check (issue: Jev client) lands on a different path
# JEV_ENDPOINT=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/run/typesafe/jev

# SLEIGHT-Bench Fernet key — published in ext/sleight-bench/README.md, read it from there
SLEIGHT_FERNET_KEY=

# Hard spend ceiling in USD. Set on day one from a measured single-transcript run, not an estimate.
MERESEARCH_BUDGET_USD=0

# Seed for the tuned/held-out category split and any sampling. Frozen once set.
MERESEARCH_SEED=20261103
